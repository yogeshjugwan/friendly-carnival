# Copy to .env for local runs (tsx does not load it automatically; export the
# variables or use `env $(cat .env | xargs) pnpm dev`).
PORT=4100
WEB_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
ADMIN_TOKEN=local-admin-token
IP_SALT=change-me-in-production
